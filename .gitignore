# Generated design-token artifacts (Style Dictionary output from tokens/**/*.json).
# Regenerate with `pnpm --filter @arkaes/tokens generate`.
packages/tokens/src/styles/tokens.generated.css
packages/tokens/src/generated/

# Generated markdown stylesheet (emitted from packages/ui/src/markdown/styles.ts).
# Regenerate with `pnpm --filter @arkaes/ui emit-css`.
packages/ui/src/styles/markdown.css

# Generated inputs and intermediates for the Design Engineer PDF. The PDF itself
# and the authored sources (document.html, assets/system-architecture.svg) are
# committed; everything below regenerates via `node docs/agileday/build.mjs`.
docs/agileday/fonts/
docs/agileday/out/
docs/agileday/assets/*.png
docs/agileday/assets/qr-*.svg
# Installed with npm because the folder sits outside the pnpm workspace; the
# lockfile is not committed so it never competes with pnpm-lock.yaml.
docs/agileday/package-lock.json
