# Copy to `.env` for local dev, and set the same vars in your Vercel project.
# Server-only — never expose these to the client (no PUBLIC_ prefix).

# Required: OpenAI API key used by the /api/chat (Arkhe) endpoint.
OPENAI_API_KEY=

# Optional: override the chat model (defaults to gpt-5.4-nano).
# OPENAI_MODEL=gpt-5.4-nano

# Optional: lock the chat endpoint to specific origins (comma-separated).
# When unset, only obvious cross-site requests are rejected. Leave unset for
# local dev / Vercel previews.
# CHAT_ALLOWED_ORIGINS=https://arkaes.dev,https://www.arkaes.dev

# RAG (Supabase pgvector). Set all three to enable retrieval; leave unset to
# fall back to the static knowledge base. Used by both the chat endpoint and
# the `pnpm --filter @arkaes/portfolio ingest` CLI. Service-role key bypasses
# RLS — keep it server-only and out of the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Knowledge admin UI (/admin/knowledge). Set ADMIN_PASSWORD to enable it;
# without it the admin routes return 503. ADMIN_USER defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=

# Blog (Contentful + ISR). Set space + delivery token to enable /blog; without
# them the blog renders an empty listing. See docs/blog-contentful-setup.md.
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
# CONTENTFUL_ENVIRONMENT=master

# ISR on-demand revalidation. VERCEL_ISR_BYPASS_TOKEN is the adapter's bypass
# token (32+ random chars); CONTENTFUL_WEBHOOK_SECRET must match the
# `x-webhook-secret` header configured on Contentful's publish webhook.
VERCEL_ISR_BYPASS_TOKEN=
CONTENTFUL_WEBHOOK_SECRET=

# Optional: only needed when the deployment has Vercel Deployment Protection
# enabled (typically previews), which would otherwise 401 the revalidation
# endpoint's own requests. Vercel generates this under Settings → Deployment
# Protection → Protection Bypass for Automation.
# VERCEL_AUTOMATION_BYPASS_SECRET=
