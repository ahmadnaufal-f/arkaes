---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { coverTransitionName, getPostBySlug } from "../../lib/contentful";
import { renderPostBody } from "../../lib/markdown";
import { AUTHOR_NAME, blogPostingSchema, breadcrumbSchema } from "../../lib/seo";
import "./_blog.css";

// On-demand + ISR, same contract as the blog index: rendered once per publish
// (or per `expiration` window), then served from the edge cache.
export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;
if (!post) {
  return new Response("Not found", { status: 404 });
}

const bodyHtml = await renderPostBody(post.body);
const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "long" });

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  blogPostingSchema(site, post),
  breadcrumbSchema(site, [
    { name: "Blog", path: "/blog" },
    { name: post.title, path: `/blog/${post.slug}` },
  ]),
];
---

<BaseLayout
  title={`${post.title} | ${AUTHOR_NAME}`}
  description={post.excerpt}
  image={post.cover?.src}
  imageAlt={post.cover?.alt}
  imageWidth={post.cover?.width}
  imageHeight={post.cover?.height}
  ogType="article"
  publishedTime={post.publishDate}
  articleTags={post.tags}
  jsonLd={jsonLd}
>
  <article class="blog-page">
    {/* The cover deliberately stays out of slot="visual": that slot is
        scroll-animated (scaled + collapsed as the header sticks), which isn't
        wanted for a blog cover. It renders with the body instead. */}
    <ark-project-header eyebrow={post.category} heading={post.title}>
      {post.tags.map((tag) => <ark-chip slot="tag">{tag}</ark-chip>)}
    </ark-project-header>

    <div class="blog-article">
      <time class="blog-article-date" datetime={post.publishDate.toISOString()}>
        {dateFormat.format(post.publishDate)}
      </time>

      {
        post.cover && (
          <img
            class="blog-article-cover"
            src={post.cover.src}
            alt={post.cover.alt}
            width={post.cover.width}
            height={post.cover.height}
            style={`view-transition-name: ${coverTransitionName(post.slug)};`}
          />
        )
      }

      <div class="ark-readable blog-body" set:html={bodyHtml} />

      <div class="blog-footer-nav">
        <ark-button href="/blog" variant="ghost">&larr; Back to blog</ark-button>
      </div>
    </div>
  </article>
</BaseLayout>
