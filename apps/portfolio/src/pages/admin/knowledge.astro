---
// Knowledge admin UI. Server-rendered and gated by the Basic Auth middleware
// (src/middleware.ts) — set ADMIN_PASSWORD to enable. Standalone layout so the
// chatbot widget and site chrome don't load here.
import { ragConfigured } from "@/lib/rag";
import "./_knowledge.css";

export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Knowledge admin · Arkhe</title>
    <style>
      body {
        background: var(--ark-color-bg);
        color: var(--ark-color-text);
        font-family: var(--ark-font-sans);
        line-height: var(--ark-leading-normal);
        margin: 0;
        padding: var(--ark-space-6);
      }
      main {
        margin: 0 auto;
        max-width: 720px;
      }
      h1 {
        font-size: var(--ark-text-xl, 1.5rem);
        margin: 0 0 var(--ark-space-2);
      }
      p.lede {
        color: var(--ark-color-text-muted);
        margin: 0 0 var(--ark-space-6);
      }
      fieldset {
        border: 1px solid var(--ark-color-border);
        border-radius: var(--ark-radius-md);
        margin: 0 0 var(--ark-space-6);
        /* Override the UA default `min-inline-size: min-content` so the fieldset
           can shrink below its content — otherwise a long source id refuses to
           truncate and overflows on narrow (mobile) viewports. */
        min-width: 0;
        padding: var(--ark-space-4);
      }
      legend {
        font-weight: var(--ark-weight-semibold);
        padding: 0 var(--ark-space-2);
      }
      label {
        display: block;
        font-size: var(--ark-text-sm);
        font-weight: var(--ark-weight-medium, 500);
        margin: 0 0 var(--ark-space-1);
      }
      .field {
        margin-bottom: var(--ark-space-4);
      }
      input[type="text"],
      textarea {
        background: var(--ark-color-surface);
        border: 1px solid var(--ark-color-border);
        border-radius: var(--ark-radius-sm, 6px);
        box-sizing: border-box;
        color: var(--ark-color-text);
        font: inherit;
        padding: var(--ark-space-2) var(--ark-space-3);
        width: 100%;
      }
      textarea {
        min-height: 8rem;
        resize: vertical;
      }
      .row {
        align-items: center;
        display: flex;
        gap: var(--ark-space-2);
      }
      .row label {
        margin: 0;
      }
      button {
        background: var(--ark-color-accent);
        border: none;
        border-radius: var(--ark-radius-sm, 6px);
        color: var(--ark-color-on-accent, #fff);
        cursor: pointer;
        font: inherit;
        font-weight: var(--ark-weight-semibold);
        padding: var(--ark-space-2) var(--ark-space-4);
      }
      button.ghost {
        background: transparent;
        border: 1px solid var(--ark-color-border);
        color: var(--ark-color-text);
      }
      button.danger {
        background: var(--ark-color-danger);
      }
      #status {
        border-radius: var(--ark-radius-sm, 6px);
        font-size: var(--ark-text-sm);
        margin-top: var(--ark-space-4);
        padding: var(--ark-space-3);
      }
      #status.ok {
        background: color-mix(in srgb, var(--ark-color-secondary) 16%, transparent);
      }
      #status.err {
        background: color-mix(in srgb, var(--ark-color-danger) 16%, transparent);
      }
      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .source-list {
        display: flex;
        flex-direction: column;
        gap: var(--ark-space-3);
      }
      .source-item {
        align-items: center;
        background: var(--ark-color-surface);
        border: 1px solid var(--ark-color-border);
        border-radius: var(--ark-radius-md);
        display: flex;
        flex-wrap: wrap;
        gap: var(--ark-space-2) var(--ark-space-3);
        padding: var(--ark-space-3) var(--ark-space-4);
        transition:
          border-color var(--ark-duration-fast) var(--ark-ease-standard),
          box-shadow var(--ark-duration-fast) var(--ark-ease-standard),
          transform var(--ark-duration-fast) var(--ark-ease-standard);
      }
      .source-item:hover {
        border-color: var(--ark-color-border-strong);
        box-shadow: var(--ark-shadow-sm);
        transform: translateY(-1px);
      }
      .source-item__icon {
        align-items: center;
        background: var(--ark-color-accent-soft);
        border-radius: var(--ark-radius-sm);
        color: var(--ark-color-accent-strong);
        display: flex;
        flex: none;
        height: 2.25rem;
        justify-content: center;
        width: 2.25rem;
      }
      .source-item__icon svg {
        height: 1.1rem;
        width: 1.1rem;
      }
      .source-item__main {
        display: flex;
        flex: 1 1 9rem;
        flex-direction: column;
        gap: var(--ark-space-1);
        min-width: 0;
        overflow: hidden;
      }
      .source-item__id {
        color: var(--ark-color-text);
        font-family: var(--ark-font-mono);
        font-size: var(--ark-text-sm);
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .source-item__count {
        align-self: flex-start;
        background: var(--ark-color-secondary-soft);
        border-radius: var(--ark-radius-full);
        color: var(--ark-color-secondary);
        font-size: var(--ark-text-xs);
        font-weight: var(--ark-weight-medium);
        letter-spacing: var(--ark-tracking-wide);
        padding: 0.1rem var(--ark-space-2);
      }
      .source-item__actions {
        display: flex;
        flex: none;
        gap: var(--ark-space-2);
        margin-left: auto;
      }
      .source-item__actions button {
        border-radius: var(--ark-radius-sm);
        font-size: var(--ark-text-sm);
        font-weight: var(--ark-weight-medium);
        padding: var(--ark-space-1) var(--ark-space-3);
      }
      .btn-edit {
        background: var(--ark-color-accent-soft);
        border: 1px solid transparent;
        color: var(--ark-color-accent-strong);
        transition:
          background-color var(--ark-duration-fast) var(--ark-ease-standard),
          color var(--ark-duration-fast) var(--ark-ease-standard);
      }
      .btn-edit:hover {
        background: var(--ark-color-accent);
        color: var(--ark-color-accent-contrast);
      }
      .btn-clear {
        background: transparent;
        border: 1px solid var(--ark-color-border);
        color: var(--ark-color-text-muted);
        transition:
          border-color var(--ark-duration-fast) var(--ark-ease-standard),
          color var(--ark-duration-fast) var(--ark-ease-standard);
      }
      .btn-clear:hover {
        border-color: var(--ark-color-danger);
        color: var(--ark-color-danger);
      }
      .source-empty {
        color: var(--ark-color-text-muted);
        font-size: var(--ark-text-sm);
        padding: var(--ark-space-6) var(--ark-space-4);
        text-align: center;
      }
      .disabled-note {
        background: color-mix(in srgb, var(--ark-color-danger) 12%, transparent);
        border-radius: var(--ark-radius-md);
        padding: var(--ark-space-4);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Knowledge admin</h1>
      <p class="lede">
        Add documents to the Arkhe RAG store. Content is chunked, embedded, and
        saved to Supabase pgvector. Use <strong>Edit</strong> on a loaded source
        to pull its original text back into the form and replace it.
      </p>

      {
        !ragConfigured && (
          <div class="disabled-note">
            Supabase is not configured. Set <code>SUPABASE_URL</code>,
            <code>SUPABASE_SERVICE_ROLE_KEY</code>, and
            <code>OPENAI_API_KEY</code> to enable ingestion.
          </div>
        )
      }

      {
        ragConfigured && (
          <>
            <form id="ingest-form">
              <fieldset>
                <legend>Add a document</legend>
                <div class="field">
                  <label for="source">Source id</label>
                  <input
                    id="source"
                    type="text"
                    placeholder="note:about-hobbies"
                    autocomplete="off"
                  />
                </div>
                <div class="field">
                  <label for="content">Content</label>
                  <textarea
                    id="content"
                    placeholder="Paste markdown or plain text…"
                    required
                  />
                </div>
                <div class="field">
                  <label for="metadata">Metadata (JSON, optional)</label>
                  <textarea id="metadata" placeholder='{"type":"note"}' />
                </div>
                <div class="field row">
                  <input id="replace" type="checkbox" checked />
                  <label for="replace">
                    Replace existing chunks for this source
                  </label>
                </div>
                <button type="submit">Ingest</button>
              </fieldset>
            </form>

            <fieldset>
              <legend>Loaded sources</legend>
              <ul id="sources" class="source-list">
                <li class="source-empty">Loading…</li>
              </ul>
              <div style="margin-top: var(--ark-space-4)">
                <button type="button" class="danger" id="clear-all">
                  Clear everything
                </button>
              </div>
            </fieldset>

            <div id="status" hidden />
          </>
        )
      }
    </main>

    <script>
      interface SourceCount {
        source: string | null;
        chunks: number;
        editable?: boolean;
      }

      // Inline document glyph for each source row.
      const DOC_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`;
      interface ApiResult {
        ok?: boolean;
        error?: string;
        documents?: number;
        chunks?: number;
        removed?: number;
        sources?: SourceCount[];
        source?: string;
        content?: string;
        metadata?: Record<string, unknown>;
      }

      const $ = <T extends HTMLElement>(id: string): T =>
        document.getElementById(id) as T;

      const form = document.getElementById("ingest-form");
      // The form only renders when RAG is configured.
      if (form) {
        const statusEl = $<HTMLDivElement>("status");
        const sourcesEl = $<HTMLUListElement>("sources");

        const setStatus = (message: string, ok: boolean) => {
          statusEl.hidden = false;
          statusEl.textContent = message;
          statusEl.className = ok ? "ok" : "err";
        };

        const api = async (
          method: string,
          body?: unknown,
        ): Promise<ApiResult> => {
          const res = await fetch("/api/admin/ingest", {
            method,
            headers: body ? { "content-type": "application/json" } : {},
            body: body ? JSON.stringify(body) : undefined,
          });
          return (await res.json()) as ApiResult;
        };

        const showMessage = (message: string) => {
          sourcesEl.innerHTML = "";
          const li = document.createElement("li");
          li.className = "source-empty";
          li.textContent = message;
          sourcesEl.append(li);
        };

        const loadSources = async () => {
          try {
            const data = await api("GET");
            const sources = data.sources ?? [];
            if (sources.length === 0) {
              showMessage("No documents yet.");
              return;
            }
            sourcesEl.innerHTML = "";
            for (const item of sources) {
              const li = document.createElement("li");
              li.className = "source-item";

              const icon = document.createElement("span");
              icon.className = "source-item__icon";
              icon.innerHTML = DOC_ICON;

              const main = document.createElement("div");
              main.className = "source-item__main";
              const code = document.createElement("code");
              code.className = "source-item__id";
              code.textContent = item.source ?? "(no source)";
              const count = document.createElement("span");
              count.className = "source-item__count";
              count.textContent = `${item.chunks} ${
                item.chunks === 1 ? "chunk" : "chunks"
              }`;
              main.append(code, count);

              li.append(icon, main);

              if (item.source) {
                const sourceId = item.source;
                const actions = document.createElement("div");
                actions.className = "source-item__actions";

                // Only offer Edit when the original text is stored to load back.
                if (item.editable) {
                  const editBtn = document.createElement("button");
                  editBtn.type = "button";
                  editBtn.className = "btn-edit";
                  editBtn.textContent = "Edit";
                  editBtn.addEventListener("click", () => {
                    void loadForEdit(sourceId);
                  });
                  actions.append(editBtn);
                }

                const clearBtn = document.createElement("button");
                clearBtn.type = "button";
                clearBtn.className = "btn-clear";
                clearBtn.textContent = "Clear";
                clearBtn.addEventListener("click", () => {
                  void removeSource(sourceId);
                });
                actions.append(clearBtn);

                li.append(actions);
              }

              sourcesEl.append(li);
            }
          } catch {
            showMessage("Failed to load sources.");
          }
        };

        const removeSource = async (source: string) => {
          const data = await api("DELETE", { source });
          setStatus(`Removed ${data.removed ?? 0} chunks from ${source}.`, true);
          await loadSources();
        };

        // Load a source's stored original into the form for editing. Re-submitting
        // with "Replace" checked overwrites the existing chunks. Documents ingested
        // before raw-text storage existed have no original to load — fall back to a
        // blank form keyed to the source so fresh content can replace it.
        const loadForEdit = async (source: string) => {
          const sourceInput = $<HTMLInputElement>("source");
          const contentInput = $<HTMLTextAreaElement>("content");
          const metadataInput = $<HTMLTextAreaElement>("metadata");
          const replaceInput = $<HTMLInputElement>("replace");

          sourceInput.value = source;
          replaceInput.checked = true;

          const res = await fetch(
            `/api/admin/ingest?source=${encodeURIComponent(source)}`,
          );
          const data = (await res.json()) as ApiResult;

          if (res.ok && typeof data.content === "string") {
            contentInput.value = data.content;
            metadataInput.value =
              data.metadata && Object.keys(data.metadata).length > 0
                ? JSON.stringify(data.metadata, null, 2)
                : "";
            setStatus(`Loaded "${source}" for editing.`, true);
          } else {
            contentInput.value = "";
            metadataInput.value = "";
            setStatus(
              `No stored original for "${source}" (ingested before edit support). Paste fresh content to replace it.`,
              false,
            );
          }

          form.scrollIntoView({ behavior: "smooth", block: "start" });
          contentInput.focus();
        };

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          void (async () => {
            const content = $<HTMLTextAreaElement>("content").value.trim();
            const source = $<HTMLInputElement>("source").value.trim();
            const replaceSource = $<HTMLInputElement>("replace").checked;
            const metaRaw = $<HTMLTextAreaElement>("metadata").value.trim();

            let metadata: unknown;
            if (metaRaw) {
              try {
                metadata = JSON.parse(metaRaw);
              } catch {
                setStatus("Metadata is not valid JSON.", false);
                return;
              }
            }

            setStatus("Embedding and saving…", true);
            try {
              const data = await api("POST", {
                content,
                source: source || undefined,
                metadata,
                replaceSource,
              });
              if (data.error) {
                setStatus(data.error, false);
                return;
              }
              setStatus(
                `Ingested ${data.documents ?? 0} document → ${data.chunks ?? 0} chunks.`,
                true,
              );
              $<HTMLTextAreaElement>("content").value = "";
              await loadSources();
            } catch {
              setStatus("Request failed.", false);
            }
          })();
        });

        $<HTMLButtonElement>("clear-all").addEventListener("click", () => {
          if (!confirm("Delete ALL knowledge documents?")) return;
          void (async () => {
            const data = await api("DELETE", { all: true });
            setStatus(`Cleared ${data.removed ?? 0} chunks.`, true);
            await loadSources();
          })();
        });

        void loadSources();
      }
    </script>
  </body>
</html>
