---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import portrait from "../assets/about-me.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import "./_index.css";
import { techGroups } from "../data/techstack";
import { EXPERTISE } from "../data/expertise";
import CaseStudyVisual from "../components/CaseStudyVisual.astro";
import {
  coverSrcSet,
  coverTransitionName,
  coverUrl,
  getAllPosts,
} from "../lib/contentful";
import {
  AUTHOR_JOB_TITLE,
  AUTHOR_NAME,
  PERSON_ID,
  WEBSITE_ID,
} from "../lib/seo";

// The "Latest Writing" strip reads blog posts from Contentful, which is a
// request-time fetch — so the homepage renders on demand and is edge-cached by
// Vercel ISR, the same arrangement the blog routes already use. A publish
// refreshes it through /api/revalidate rather than waiting on a redeploy.
export const prerender = false;

// Width at which the case-study and latest-writing grids become carousels.
// ark-carousel owns the switch (it reflects `active`), so _index.css keys its
// carousel-mode rules off that attribute rather than repeating the media query.
const MOBILE_CAROUSEL_BREAKPOINT = 900;

const CARD_ORDER = ["virtual-home", "virtual-home-tv", "milk-tracker", "air-care"];
const getOrder = (id: string) => { const i = CARD_ORDER.indexOf(id); return i === -1 ? Infinity : i; };

const allStudies = await getCollection("caseStudies");
const featuredStudies = allStudies
  .filter((s) => s.data.featured)
  .sort((a, b) => getOrder(a.id) - getOrder(b.id));

const services = EXPERTISE.map((area) => ({
  name: area.label,
  description: area.description,
  techStack: area.techStack,
  relatedWork: area.relatedWork,
}));

const domainCount = techGroups.length;
const techCount = techGroups.reduce((total, group) => total + group.items.length, 0);

// getAllPosts() already comes back newest-first from Contentful, so taking the
// first three is the whole selection rule. It returns [] when Contentful isn't
// configured (local dev, previews without secrets), which the section's length
// guard below relies on to disappear cleanly instead of rendering an empty grid.
const latestPosts = (await getAllPosts()).slice(0, 3);

// The homepage is the Person node's canonical page: mainEntity ties the two
// together so a search engine reading this URL knows the site is *about* this
// person rather than merely mentioning them.
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  {
    "@type": "ProfilePage",
    "@id": new URL("/", site).href,
    url: new URL("/", site).href,
    name: `${AUTHOR_NAME} — ${AUTHOR_JOB_TITLE}`,
    inLanguage: "en",
    isPartOf: { "@id": WEBSITE_ID(site) },
    mainEntity: { "@id": PERSON_ID(site) },
  },
];
---

<BaseLayout
  title={`${AUTHOR_NAME} — Frontend Engineer & UI Systems Architect`}
  description="Performance-focused frontend engineering portfolio for UI systems, design systems, and cross-platform products."
  jsonLd={jsonLd}
>
  <a class="skip-link" href="#case-studies">Skip to case studies</a>

  {/* The headline and subtitle are passed as light-DOM slot content rather
      than as `title`/`subtitle` attributes: attribute-driven text is rendered
      into the shadow root, so it only exists after the Lit bundle upgrades the
      element and never appears in the served HTML. As slotted children they are
      real markup in the response — the page's h1 — which crawlers that don't
      execute JS can read. ark-hero's `::slotted([slot="title"])` rules style
      them identically; the emphasis markup is styled from _index.css, since
      ::slotted() can't reach descendants of the slotted node. */}
  <ark-hero
    primary-href="#contact"
    primary-label="Contact me"
    comp-label="Ahmad Naufal - mmxxvi"
    scroll-label="Explore the work"
  >
    {/* Slotted rather than passed as the `chips` attribute for the same reason
        as the headline below — attribute-driven chips are rendered into the
        shadow root and never appear in the served HTML — and because the
        attribute renders one variant for the whole row, while the AI practice
        is deliberately marked `emerging` against the two `primary` roles. */}
    <ark-chip slot="eyebrow" variant="primary">Frontend Engineer</ark-chip>
    <ark-chip slot="eyebrow" variant="primary">UI Systems Architect</ark-chip>
    <ark-chip slot="eyebrow" variant="emerging">Applied AI Interfaces</ark-chip>

    <h1 slot="title" class="hero-headline">
      <span class="hero-headline-line hero-headline-line--lead">Frontend engineering</span>
      <span class="hero-headline-line"><em>with clarity.</em></span>
    </h1>
    <p slot="subtitle">
      Building scalable interfaces, design systems, and cross-platform products
      where technical structure and visual refinement work as one.
    </p>
  </ark-hero>

  <div class="marquee-section" aria-hidden="true">
    <div class="marquee-track" data-marquee-track>
      <div class="marquee-group" data-marquee-group>
        <div class="marquee-item">Frontend Architecture</div>
        <div class="marquee-item">Design Systems</div>
        <div class="marquee-item">Performance Engineering</div>
        <div class="marquee-item">Cross-platform Apps</div>
        <div class="marquee-item">Interaction Engineering</div>
        <div class="marquee-item">Product Thinking</div>
      </div>
    </div>
  </div>

  <script>
    const SECONDS_PER_GROUP = 24;

    function setupMarquee(track: HTMLElement) {
      const base = track.querySelector<HTMLElement>("[data-marquee-group]");
      if (!base) return;

      track
        .querySelectorAll("[data-marquee-group][data-clone]")
        .forEach((node) => node.remove());

      const groupWidth = base.offsetWidth;
      if (groupWidth === 0) return;

      const copiesPerHalf = Math.max(1, Math.ceil(window.innerWidth / groupWidth));
      const totalGroups = copiesPerHalf * 2;

      const fragment = document.createDocumentFragment();
      for (let i = 1; i < totalGroups; i += 1) {
        const clone = base.cloneNode(true) as HTMLElement;
        clone.setAttribute("data-clone", "");
        fragment.appendChild(clone);
      }
      track.appendChild(fragment);
      track.style.animationDuration = `${copiesPerHalf * SECONDS_PER_GROUP}s`;
    }

    function initMarquees() {
      document
        .querySelectorAll<HTMLElement>("[data-marquee-track]")
        .forEach(setupMarquee);
    }

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(initMarquees, 150);
    });

    initMarquees();
  </script>

  <section class="work-section" id="case-studies">
    <div class="section-header reveal">
      <div>
        <div class="section-eyebrow">Selected Case Studies</div>
        <h2 class="section-title">Systems I have <em>shaped</em></h2>
      </div>
      <div class="section-count">{String(featuredStudies.length).padStart(2, "0")} / Selected</div>
    </div>

    {/* Grid on desktop, carousel under 900px — see MOBILE_CAROUSEL_BREAKPOINT.
        ark-carousel's track is display: contents while inactive, so the grid
        rules on .projects-grid apply straight to these cards, including in the
        server-rendered HTML before the element upgrades. */}
    <ark-carousel
      class="projects-grid reveal reveal-delay-1"
      breakpoint={MOBILE_CAROUSEL_BREAKPOINT}
      label="Case studies"
      prev-label="Previous case study"
      next-label="Next case study"
    >
      {featuredStudies.map((study) => (
        <ark-media-card
          class="project-card"
          href={`/case-studies/${study.id}`}
          title={study.data.title}
        >
          <CaseStudyVisual
            visual={study.data.visual}
            asSlot="media"
            transitionName={`proj-thumb-${study.id}`}
          />
          {study.data.tags.map((tag) => (
            <ark-chip slot="tag">{tag}</ark-chip>
          ))}
        </ark-media-card>
      ))}
    </ark-carousel>

    <div class="section-cta reveal">
      <ark-button class="section-cta-accent" href="/case-studies" variant="primary">
        View all case studies
        <span slot="suffix" aria-hidden="true">&rarr;</span>
      </ark-button>
      <ark-button href="/projects" variant="secondary">
        Browse all projects
        <span slot="suffix" aria-hidden="true">&rarr;</span>
      </ark-button>
    </div>
  </section>

  <section class="services-section" id="expertise">
    <div class="section-header reveal">
      <div>
        <div class="section-eyebrow">Core Expertise</div>
        <h2 class="section-title">Engineering <em>focus</em></h2>
      </div>
    </div>

    <ark-accordion class="services-list" type="single" auto-scroll-when-expanded>
      {services.map((service, index) => (
        <ark-accordion-item class={`service-item reveal${index > 0 ? ` reveal-delay-${index}` : ""}`}>
          <span slot="trigger" class="service-trigger">
            <span class="service-num">{String(index + 1).padStart(2, "0")}</span>
            <span class="service-name">{service.name}</span>
          </span>
          <div class="service-body">
            <p class="service-desc">{service.description}</p>
            <div class="service-meta">
              <div class="service-meta-group">
                <div class="service-meta-label">Tech stack</div>
                <div class="service-tags">
                  {service.techStack.map((tech) => (
                    <ark-chip>{tech}</ark-chip>
                  ))}
                </div>
              </div>
              <div class="service-meta-group">
                <div class="service-meta-label">Related work</div>
                <div class="service-tags">
                  {service.relatedWork.map((work) => (
                    <ark-chip variant="accent">{work}</ark-chip>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </ark-accordion-item>
      ))}
    </ark-accordion>
  </section>

  <section class="techstack-section" id="techstack">
    <div class="section-header reveal">
      <div>
        <div class="section-eyebrow">Tech Stacks & Tools</div>
        <h2 class="section-title">What I <em>build with</em></h2>
      </div>
      <div class="techstack-meta">
        {domainCount} Domains<br />
        {techCount}+ Technologies
      </div>
    </div>

    <ul class="techstack-index">
      {techGroups.map((group, index) => {
        const num = String(index + 1).padStart(2, "0");
        const rowClass = ["techstack-row", group.emerging && "techstack-row--emerging", "reveal", `reveal-delay-${index + 1}`]
          .filter(Boolean)
          .join(" ");
        return (
          <li class={rowClass}>
            <div class="techstack-row-head">
              <span class="techstack-row-num">{num}</span>
              {group.emerging && <span class="techstack-row-tag">Emerging</span>}
            </div>
            <h3 class="techstack-row-name">
              <span class="techstack-row-name-roman">{group.label}</span>
              <span class="techstack-row-name-italic" aria-hidden="true">{group.label}</span>
            </h3>
            <div class="techstack-row-items">
              {group.items.map((item) => {
                const variant = item.learning
                  ? "learning"
                  : item.primary
                    ? (group.emerging ? "emerging" : "primary")
                    : "default";
                return <ark-chip variant={variant}>{item.name}</ark-chip>;
              })}
            </div>
          </li>
        );
      })}
    </ul>

    <div class="techstack-footer reveal">
      <p class="techstack-note">
        Primary framework is Lit for enterprise work. React for side projects and experiments. All
        stacks applied to shipped, production software.
      </p>
    </div>
  </section>

  <script>
    // Light up every chip in a tech-stack row when the row is hovered.
    // ark-chip lives in shadow DOM, so this drives its isHovered API rather
    // than relying on a CSS descendant selector.
    (function () {
      const rows = document.querySelectorAll<HTMLElement>(".techstack-row");
      rows.forEach((row) => {
        const chips = row.querySelectorAll<HTMLElement & { isHovered: boolean }>("ark-chip");
        const setHovered = (value: boolean) => {
          chips.forEach((chip) => {
            chip.isHovered = value;
          });
        };
        row.addEventListener("mouseenter", () => setHovered(true));
        row.addEventListener("mouseleave", () => setHovered(false));
      });
    })();
  </script>

  {latestPosts.length > 0 && (
    <section class="writing-section" id="writing">
      <div class="section-header reveal">
        <div>
          <div class="section-eyebrow">Latest Writing</div>
          <h2 class="section-title">Notes on <em>craft</em></h2>
        </div>
        <div class="section-count">{String(latestPosts.length).padStart(2, "0")} / Recent</div>
      </div>

      <ark-carousel
        class="writing-grid reveal reveal-delay-1"
        breakpoint={MOBILE_CAROUSEL_BREAKPOINT}
        label="Latest writing"
        prev-label="Previous post"
        next-label="Next post"
      >
        {latestPosts.map((post) => (
          <div class="writing-card">
            <ark-media-card
              category={post.category}
              datetime={post.publishDate.toISOString()}
              href={`/blog/${post.slug}`}
              summary={post.excerpt}
              title={post.title}
              variant="compact"
            >
              {post.cover && (
                <img
                  slot="media"
                  class="writing-cover"
                  src={coverUrl(post.cover.src, 400)}
                  srcset={coverSrcSet(post.cover.src, [320, 640])}
                  sizes="(max-width: 720px) 100vw, 360px"
                  alt={post.cover.alt}
                  width={post.cover.width}
                  height={post.cover.height}
                  loading="lazy"
                  style={`view-transition-name: ${coverTransitionName(post.slug)};`}
                />
              )}
              {post.tags.map((tag) => <ark-chip slot="tag">{tag}</ark-chip>)}
            </ark-media-card>
          </div>
        ))}
      </ark-carousel>

      <div class="section-cta reveal">
        <ark-button class="section-cta-accent" href="/blog" variant="primary">
          Read all posts
          <span slot="suffix" aria-hidden="true">&rarr;</span>
        </ark-button>
      </div>
    </section>
  )}

  <section class="about-strip" id="about">
    <div class="about-portrait reveal">
      <Image
        class="portrait-img"
        src={portrait}
        alt="Ahmad Naufal"
        widths={[320, 640]}
        sizes="320px"
        loading="lazy"
        transition:name="about-me"
      />
      <div class="portrait-rule"></div>
    </div>
    <div class="about-content reveal reveal-delay-2">
      <div class="section-eyebrow">About</div>
      <h2 class="about-title">Engineering <em>intentional</em> interfaces<br />for product clarity</h2>
      <p class="about-strip-body">
        I build frontend systems that help products feel clearer, calmer, and easier to maintain. My
        strength is not only in writing UI code, but also in shaping structure, improving team
        workflows, and mentoring others so the product can grow without becoming harder to work on.
      </p>
      <ark-button class="about-cta" href="/about" variant="primary">
        More about me
        <span slot="suffix" aria-hidden="true">&rarr;</span>
      </ark-button>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="contact-inner">
      <ark-badge variant="eyebrow" class="reveal">Get in touch</ark-badge>
      <h2 class="contact-title reveal reveal-delay-1">
        Let's build interfaces<br /><em>that hold up.</em>
      </h2>
      <a
        href="mailto:me@arkaes.dev"
        class="contact-email reveal reveal-delay-2"
      >
        me@arkaes.dev
      </a>
      <div class="contact-socials reveal reveal-delay-3">
        <a
          href="https://github.com/ahmadnaufal-f"
          class="contact-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-social-label">GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/ahmad-naufal-f/"
          class="contact-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-social-label">LinkedIn</span>
        </a>
      </div>
    </div>

    <div class="contact-wordmark" aria-hidden="true">
      <span class="wordmark">ARK<em class="ae">&AElig;</em>S</span>
    </div>
  </section>

</BaseLayout>
