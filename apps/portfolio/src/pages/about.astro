---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/about-me.png";
import { parseSections, renderSectionHtml } from "../utils/sections";
import aboutContent from "../content/about.md?raw";
import { AUTHOR_NAME, PERSON_ID, WEBSITE_ID, breadcrumbSchema } from "../lib/seo";
import "./_about.css";

// Eagerly import every about illustration SVG as a raw string so we can
// inline it and let the page's loaded Google Fonts apply inside the markup.
const svgModules = import.meta.glob<string>("../../public/about/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const diagrams: Record<string, string> = {};
for (const [path, source] of Object.entries(svgModules)) {
  const fileName = path.split("/").pop()?.replace(".svg", "");
  if (fileName) diagrams[fileName] = source;
}

// Sections live in src/content/about.md, one `## Heading` per accordion item.
const sections = parseSections(aboutContent);

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  {
    "@type": "AboutPage",
    "@id": new URL("/about", site).href,
    url: new URL("/about", site).href,
    name: `About ${AUTHOR_NAME}`,
    inLanguage: "en",
    isPartOf: { "@id": WEBSITE_ID(site) },
    mainEntity: { "@id": PERSON_ID(site) },
  },
  breadcrumbSchema(site, [{ name: "About", path: "/about" }]),
];
---

<BaseLayout
  title={`About | ${AUTHOR_NAME}`}
  description="About Ahmad Naufal, a frontend engineer focused on scalable, maintainable, and pleasant interfaces."
  jsonLd={jsonLd}
>
  <section class="page-section narrow">
    {/* Light-DOM slot content, not a `heading` attribute — see
        FilterableListing.astro. */}
    <ark-page-header eyebrow="About">
      <h1 slot="title">Frontend engineering with a product eye.</h1>
    </ark-page-header>

    <ark-accordion class="about-accordion">
      {
        sections.map(({ heading, content }, index) => (
          <ark-accordion-item heading={heading} open={index === 0 ? "" : undefined}>
            {/* Same widths/sizes as the homepage's portrait on purpose:
                identical renditions mean the `about-me` shared-element
                transition morphs one already-cached image rather than
                cross-fading two different files. */}
            {index === 0 && (
              <Image
                class="about-summary-portrait"
                src={portrait}
                alt="Ahmad Naufal"
                widths={[320, 640]}
                sizes="320px"
                transition:name="about-me"
              />
            )}
            <div
              class="about-body"
              set:html={renderSectionHtml(content, diagrams)}
            />
          </ark-accordion-item>
        ))
      }
    </ark-accordion>

    <div class="about-footer-nav">
      <ark-button href="/" variant="ghost">&larr; Back to home page</ark-button>
    </div>
  </section>
</BaseLayout>
