---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterableListing from "../../components/FilterableListing.astro";
import type { ListingItem } from "../../components/FilterableListing.astro";
import { expertiseForProject } from "../../data/expertise";
import {
  AUTHOR_NAME,
  breadcrumbSchema,
  collectionPageSchema,
} from "../../lib/seo";

const entries = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);
const items: ListingItem[] = entries.map((study) => ({
  title: study.data.title,
  summary: study.data.shortDesc,
  href: `/case-studies/${study.id}`,
  categorySlug: study.data.category,
  expertise: expertiseForProject(study.data.projectName),
  tags: study.data.tags.slice(0, 3),
  visual: study.data.visual,
  // Matches the detail page hero so the thumbnail morphs across navigation.
  transitionName: `proj-thumb-${study.id}`,
}));

const PAGE_DESCRIPTION =
  "In-depth engineering case studies from the Arkaes portfolio.";

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  {
    ...collectionPageSchema(site, {
      name: `Case Studies | ${AUTHOR_NAME}`,
      description: PAGE_DESCRIPTION,
      path: "/case-studies",
    }),
    mainEntity: {
      "@type": "ItemList",
      itemListElement: items.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.title,
        url: new URL(item.href, site).href,
      })),
    },
  },
  breadcrumbSchema(site, [{ name: "Case Studies", path: "/case-studies" }]),
];
---

<BaseLayout
  title={`Case Studies | ${AUTHOR_NAME}`}
  description={PAGE_DESCRIPTION}
  jsonLd={jsonLd}
>
  <FilterableListing
    eyebrow="Case Studies"
    title="Deep dives into shipped frontend work."
    description="Detailed engineering case studies, filterable by context and expertise."
    items={items}
  />
</BaseLayout>
