---
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { fadeThroughBlank } from "../transitions/fade-through-blank";
import {
  AUTHOR_NAME,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  SITE_NAME,
  personSchema,
  serializeJsonLd,
  websiteSchema,
  type SchemaNode,
} from "../lib/seo";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
  /** Share image — absolute, or root-relative to be resolved against the site. */
  image?: string;
  imageAlt?: string;
  /** Intrinsic size of `image`; omit when unknown (the tags are then skipped). */
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article";
  /** Article-only Open Graph metadata; ignored when ogType is "website". */
  publishedTime?: Date;
  articleTags?: readonly string[];
  /** Keep the page out of search indexes (it stays reachable and crawlable). */
  noindex?: boolean;
  /** Page-specific schema.org nodes, merged into the site-wide @graph. */
  jsonLd?: readonly SchemaNode[];
}

const {
  description = "A performance-first portfolio powered by Astro and a small Lit-based design system.",
  title = `${AUTHOR_NAME} — ${SITE_NAME}`,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  ogType = "website",
  publishedTime,
  articleTags = [],
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Astro.site is set in astro.config.mjs; fall back to the request URL so
// preview deployments still emit sane absolute URLs.
const site = Astro.site ?? new URL(Astro.url.origin);
// Astro serves both /page and /page/ (trailingSlash: "ignore"), and prerendered
// routes report the trailing-slash form. Normalize to the slashless spelling so
// the canonical agrees with how every internal link, the sitemap, and the JSON-LD
// address the same page — otherwise the two forms look like duplicate URLs.
const canonical = new URL(
  Astro.url.pathname.replace(/(.)\/$/, "$1"),
  site,
);

// og:image must be absolute. Resolving through URL() leaves an already-absolute
// source (e.g. a Contentful asset) untouched and promotes a root-relative path.
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, site);
// Dimensions are only known for the built-in default unless a caller supplies
// them; emitting wrong ones is worse than emitting none.
const ogImageWidth = image ? imageWidth : DEFAULT_OG_IMAGE_WIDTH;
const ogImageHeight = image ? imageHeight : DEFAULT_OG_IMAGE_HEIGHT;

// The Person and WebSite nodes carry the site's identity, so every page emits
// them; page-specific nodes reference them by @id rather than repeating them.
const schemaGraph = serializeJsonLd([
  personSchema(site),
  websiteSchema(site),
  ...jsonLd,
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="theme-color" content="#8f554d" />
    <meta name="author" content={AUTHOR_NAME} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${AUTHOR_NAME} — Blog`}
      href={new URL("/rss.xml", site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {
      ogType === "article" && (
        <>
          {publishedTime && (
            <meta
              property="article:published_time"
              content={publishedTime.toISOString()}
            />
          )}
          <meta property="article:author" content={AUTHOR_NAME} />
          {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? title} />
    <script type="application/ld+json" is:inline set:html={schemaGraph} />
    {
      /* Self-hosted fonts (see astro.config.mjs `fonts`). Emits @font-face plus
         a preload link for the woff2 files so text renders in the correct
         family immediately, without the fallback→web-font swap.

         Written as an expression comment, not an HTML one: an HTML comment
         here reaches the compiled output, and the compiler mis-terminates it
         at any markup it contains — the tail then lands in <head> as bare
         text, which closes <head> early and paints as body content. */
    }
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload />
    <ClientRouter />
    <title>{title}</title>
    <style>
      #page-loader {
        align-items: center;
        background: var(--ark-color-bg, #fbf8f3);
        display: flex;
        inset: 0;
        justify-content: center;
        opacity: 1;
        pointer-events: all;
        position: fixed;
        transition: opacity 300ms var(--ark-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: 9999;
      }
      #page-loader.page-loader--done {
        opacity: 0;
        pointer-events: none;
      }
      @keyframes page-loader-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .page-loader-spinner {
        animation: page-loader-spin 0.9s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        border-color: transparent;
        border-radius: 50%;
        border-style: solid;
        border-top-color: var(--ark-color-accent, #8f554d);
        border-right-color: color-mix(
          in srgb,
          var(--ark-color-accent, #8f554d) 33%,
          transparent
        );
        border-width: 2px;
        display: inline-block;
        height: 36px;
        width: 36px;
      }
      @media (prefers-reduced-motion: reduce) {
        #page-loader {
          transition: none;
        }
        .page-loader-spinner {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    {
      /* Must stay in the body, never the head: this renders a
         `vercel-analytics` custom element, and an unknown element inside the
         head makes the HTML parser close it early and open the body (per the
         "in head" insertion mode's "anything else" rule). Everything after it —
         the title, the ClientRouter script, and crucially the stylesheet link
         tags — would then land in the body, where ClientRouter's
         `preloadStyleLinks` (which only queries `head link[rel=stylesheet]`)
         can't preload them and `swapBodyElement` destroys them on every
         navigation, leaving the page with no CSS until the stylesheets
         re-fetch.

         An expression comment, and phrased without literal tags: an HTML
         comment containing markup reaches the output and the compiler can
         mis-terminate it, spilling its tail into the page as text. */
    }
    <Analytics />
    <div id="nav-progress" transition:persist aria-hidden="true"></div>
    <div id="page-loader" aria-hidden="true">
      <span class="page-loader-spinner"></span>
    </div>
    <SiteHeader />
    <main id="top" transition:animate={fadeThroughBlank}>
      <slot />
    </main>
    <SiteFooter />

    <!-- Bottom-edge dock: the counterpart to the nav's immersive header, and it
         follows the same scroll rule. Persisted across View Transitions as a
         whole, so an open Arkhe conversation survives client-side navigation.
         The chatbot is `docked`, which hands its launcher's placement to the
         container; its panel stays fixed to the viewport. -->
    <ark-floating-action-container transition:persist="floating-actions">
      <ark-chatbot
        docked
        heading="Arkhe"
        tagline="Ask about Ahmad's work"
        launcher-label="Chat with Arkhe"
      ></ark-chatbot>
      <ark-scroll-top label="Back to top"></ark-scroll-top>
    </ark-floating-action-container>

    <script>
      // Register the full custom-element set once for the document lifetime so
      // elements stay defined across client-side View Transitions navigations.
      import "@arkaes/ui/register";
      import "@arkaes/chatbot/register";
      import { enableArkCursor } from "@arkaes/ui/components/ark-cursor";
      import type { ArkButton, ArkMediaCard } from "@arkaes/ui";
      import type { ArkNavLink, ArkNavigationCta } from "@arkaes/ui";

      // ── Persistent setup (runs once for the document lifetime) ──────────
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Custom cursor — the component owns the arrow/label chip, native-cursor
      // hiding, hover detection (across shadow DOM), capability gating, and
      // View Transition persistence. See @arkaes/ui.
      enableArkCursor();

      // Before the DOM swap, close any open dialogs so their portal containers
      // don't linger on the body after navigation.
      document.addEventListener("astro:before-swap", () => {
        document
          .querySelectorAll<
            HTMLElement & { open: boolean }
          >("ark-dialog-root[open]")
          .forEach((root) => {
            root.open = false;
          });
      });

      // ── Global navigation progress bar ──────────────────────────────
      // A persistent top-of-page bar giving continuous feedback from the moment
      // a navigation starts (click, keyboard, or back/forward) until the new
      // page is loaded and shown. The reveal itself is already ready-gated —
      // ClientRouter awaits the incoming page's stylesheet preloads before the
      // swap, and custom elements are registered for the document lifetime — so
      // this bar is feedback only, not a gate.
      const navProgress = {
        set(scale: number, animate = true) {
          const node = document.getElementById("nav-progress");
          if (!node) return;
          if (animate) {
            node.style.transform = `scaleX(${scale})`;
          } else {
            node.style.transition = "none";
            node.style.transform = `scaleX(${scale})`;
            void node.offsetWidth; // flush so the next change animates from here
            node.style.transition = "";
          }
        },
        start() {
          const node = document.getElementById("nav-progress");
          if (!node) return;
          this.set(reduceMotion ? 1 : 0, false);
          node.classList.add("is-active");
          // Trickle toward — but never reach — the end while the fetch is in
          // flight; reduced motion shows a static full-width bar instead.
          if (!reduceMotion) requestAnimationFrame(() => this.set(0.3));
        },
        advance() {
          const node = document.getElementById("nav-progress");
          if (node?.classList.contains("is-active") && !reduceMotion) this.set(0.7);
        },
        done() {
          const node = document.getElementById("nav-progress");
          if (!node || !node.classList.contains("is-active")) return;
          this.set(1);
          node.classList.remove("is-active"); // fade out via CSS opacity
          window.setTimeout(() => this.set(0, false), 250);
        },
      };

      // A view transition's "old" snapshot is captured at whatever scroll
      // position the outgoing page is currently at, while Astro scrolls the
      // incoming page to the top by default (`moveToLocation` in Astro's
      // router). Left alone, that mismatch crossfades two different scroll
      // windows of content on top of each other — e.g. an outgoing page
      // scrolled mid-article ghosting through an incoming page's heading.
      // Scrolling the outgoing page to top ourselves, right before Astro
      // starts the view transition, makes both snapshots depict the same
      // "top of page" content so they cleanly fade through blank instead.
      // Skipped for back/forward (`traverse`) navigations, where Astro
      // restores the destination's own saved scroll position instead of
      // scrolling to top — forcing top here would just trade one mismatch
      // for another.
      let isTraverseNavigation = false;
      document.addEventListener("astro:before-preparation", (event) => {
        isTraverseNavigation = event.navigationType === "traverse";
        navProgress.start();
      });
      document.addEventListener("astro:after-preparation", () => {
        if (!isTraverseNavigation) {
          window.scrollTo({ left: 0, top: 0, behavior: "instant" });
        }
        navProgress.advance();
      });

      // Activate the loading/navigating state on the clicked link element as
      // soon as the user clicks, so there is immediate feedback while
      // Astro's ClientRouter fetches the next page in the background.
      const NAV_TAGS = new Set([
        "ARK-BUTTON",
        "ARK-MEDIA-CARD",
        "ARK-NAV-LINK",
        "ARK-NAVIGATION-CTA",
      ]);
      // These expose the state as `loading`; the nav elements call it `navigating`.
      const LOADING_PROP_TAGS = new Set(["ARK-BUTTON", "ARK-MEDIA-CARD"]);
      let pendingNavEls: Element[] = [];
      let navSafetyTimer: number | undefined;

      // Idempotent: clears every pending spinner and the safety timer. Runs on
      // swap and page-load (normal completion) and via a timeout (aborted or
      // failed navigation) so a spinner can never get stuck.
      const clearPendingNav = () => {
        window.clearTimeout(navSafetyTimer);
        pendingNavEls.forEach((el) => {
          if (LOADING_PROP_TAGS.has(el.tagName)) {
            (el as ArkButton | ArkMediaCard).loading = false;
          } else {
            (el as ArkNavLink | ArkNavigationCta).navigating = false;
          }
        });
        pendingNavEls = [];
      };

      document.addEventListener("click", (e) => {
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;

        const path = e.composedPath();

        const anchor = path.find((el): el is HTMLAnchorElement => el instanceof HTMLAnchorElement);
        if (!anchor?.href || (anchor.target && anchor.target !== "_self")) return;

        let url: URL;
        try {
          url = new URL(anchor.href);
        } catch {
          return;
        }

        // Only same-origin navigations that actually load a different page.
        // Hash-only changes (same pathname) are instant scroll — no loading needed.
        if (url.origin !== location.origin || url.pathname === location.pathname) return;

        const host = path.find((el): el is Element => el instanceof Element && NAV_TAGS.has(el.tagName));
        if (!host) return;

        if (LOADING_PROP_TAGS.has(host.tagName)) {
          (host as ArkButton | ArkMediaCard).loading = true;
        } else {
          (host as ArkNavLink | ArkNavigationCta).navigating = true;
        }
        pendingNavEls.push(host);
        // Safety net: if the navigation is aborted or fails (no swap / no
        // page-load ever fires), don't leave the spinner running forever.
        window.clearTimeout(navSafetyTimer);
        navSafetyTimer = window.setTimeout(clearPendingNav, 8000);
      });

      // Clear the per-element spinners before the DOM swap (the transition takes
      // over as feedback), and again on page-load as a backstop. The persisted
      // #nav-progress bar bridges the rest of the way to the ready new page.
      document.addEventListener("astro:before-swap", clearPendingNav);

      const scrollToTop = () => {
        window.scrollTo({
          top: 0,
          behavior: reduceMotion ? "auto" : "smooth",
        });
      };

      // ── Per-page setup (runs on first load and after every navigation) ──
      const initPage = () => {
        const loader = document.getElementById("page-loader");
        if (loader) {
          loader.classList.add("page-loader--done");
          setTimeout(() => loader.remove(), 350);
        }

        const reveals = document.querySelectorAll(".reveal");
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        reveals.forEach((element) => observer.observe(element));

        document
          .querySelectorAll<HTMLElement>("[data-scroll-top]")
          .forEach((element) => {
            element.addEventListener("click", (event) => {
              event.preventDefault();
              scrollToTop();
            });
          });
      };

      document.addEventListener("astro:page-load", () => {
        navProgress.done();
        clearPendingNav();
        initPage();
      });
    </script>
  </body>
</html>
