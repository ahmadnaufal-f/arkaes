---
interface Props {
  transitionName: string;
  asSlot?: string;
}
const { transitionName, asSlot } = Astro.props;
---

<div
  class="thumb-find-ios"
  slot={asSlot}
  style={`view-transition-name: ${transitionName};`}
>
  <div class="thumb-find-ios-card">
    <svg
      class="thumb-find-ios-svg"
      viewBox="0 0 240 180"
      role="img"
      aria-label="A phone map with a location pin beside a tag marker"
    >
      <!-- Phone map -->
      <rect class="find-phone" x="39" y="12" width="98" height="156" rx="19" />
      <rect class="find-screen" x="46" y="20" width="84" height="140" rx="12" />
      <rect class="find-speaker" x="76" y="25" width="24" height="3" rx="1.5" />

      <g class="find-map" aria-hidden="true">
        <path class="find-water" d="M50 114 C68 105 67 89 80 79 S101 63 105 48" />
        <path class="find-road" d="M53 49 C70 57 76 70 91 78 S112 96 127 100" />
        <path class="find-road find-road--secondary" d="M57 143 C73 126 86 122 99 107 S116 86 126 78" />
        <path class="find-road" d="M54 91 C67 88 77 89 86 94" />
        <path class="find-block" d="M57 37h13v9H57zM112 40h11v13h-11zM57 126h14v10H57zM110 119h13v12h-13z" />
      </g>

      <!-- Location pin on the map -->
      <path
        class="find-pin"
        d="M83 69c0-8.6 7-15.5 15.5-15.5S114 60.4 114 69c0 11.8-15.5 27-15.5 27S83 80.8 83 69Z"
      />
      <circle class="find-pin-center" cx="98.5" cy="69" r="4.2" />

      <!-- A restrained link from the phone to a nearby tag -->
      <path class="find-link" d="M111 92c10 6 19 2 29-7s13-7 18-3" />
      <path class="find-tag" d="M164 68h23l15 16-15 16h-23a6 6 0 0 1-6-6V74a6 6 0 0 1 6-6Z" />
      <circle class="find-tag-hole" cx="164" cy="84" r="2.4" />
      <path class="find-tag-line" d="M173 80h13M173 87h9" />
    </svg>
  </div>
</div>

<style>
  .thumb-find-ios {
    align-items: center;
    background: var(--thumbnail-background, var(--ark-color-accent-soft));
    display: flex;
    height: var(--thumbnail-height, auto);
    justify-content: center;
    position: relative;
  }

  /* The centered card follows the same compact scale as the other project
     thumbnails, leaving room around its shadow. */
  .thumb-find-ios-card {
    background: var(--ark-color-surface);
    border: 1px solid var(--ark-color-border);
    border-radius: 20px;
    box-shadow: var(--ark-shadow-md);
    padding: 12px;
    width: 220px;
  }

  .thumb-find-ios-svg {
    display: block;
    height: auto;
    width: 100%;
  }

  .find-phone {
    fill: var(--ark-color-surface);
    stroke: var(--ark-color-border);
    stroke-width: 1.5;
  }

  .find-screen {
    fill: var(--ark-color-neutral-50);
  }

  .find-speaker {
    fill: var(--ark-color-neutral-300);
  }

  .find-water {
    fill: none;
    stroke: var(--ark-color-secondary-soft);
    stroke-linecap: round;
    stroke-width: 8;
  }

  .find-road {
    fill: none;
    stroke: var(--ark-color-neutral-200);
    stroke-linecap: round;
    stroke-width: 4;
  }

  .find-road--secondary {
    stroke: var(--ark-color-neutral-100);
    stroke-width: 3;
  }

  .find-block {
    fill: color-mix(in srgb, var(--ark-color-accent) 12%, transparent);
  }

  .find-pin {
    fill: var(--ark-color-accent);
    stroke: var(--ark-color-neutral-0);
    stroke-width: 2;
  }

  .find-pin-center {
    fill: var(--ark-color-neutral-0);
  }

  .find-link {
    fill: none;
    stroke: color-mix(in srgb, var(--ark-color-accent) 48%, transparent);
    stroke-dasharray: 2 5;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .find-tag {
    fill: var(--ark-color-secondary-soft);
    stroke: var(--ark-color-secondary);
    stroke-width: 1.5;
  }

  .find-tag-hole {
    fill: var(--ark-color-secondary);
  }

  .find-tag-line {
    fill: none;
    stroke: color-mix(in srgb, var(--ark-color-secondary) 62%, transparent);
    stroke-linecap: round;
    stroke-width: 2;
  }
</style>
